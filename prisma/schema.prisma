generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Severity {
  P0
  P1
  P2
  P3
}

// ---------- Bug Tracker ----------

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssueEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  MARKED_VALID
  MARKED_INVALID
  DELETED
}

model Team {
  id        String        @id @default(cuid())
  name      String        @unique
  features  FeaturePage[]
  createdAt DateTime      @default(now())
}

model FeaturePage {
  id        String       @id @default(cuid())
  name      String       @unique
  teamId    String?
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  sheetUrl  String?
  issues    Issue[]
  events    IssueEvent[]
  createdAt DateTime     @default(now())

  @@index([teamId])
}

model Issue {
  id            String       @id @default(cuid())
  featurePageId String
  featurePage   FeaturePage  @relation(fields: [featurePageId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  severity      Severity     @default(P2)
  status        IssueStatus  @default(OPEN)
  isValid       Boolean      @default(true)
  reporter      String?
  assignee      String?
  events        IssueEvent[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([featurePageId])
  @@index([assignee])
}

/// One row per change to an issue; feeds the Activity page.
model IssueEvent {
  id            String         @id @default(cuid())
  featurePageId String
  featurePage   FeaturePage    @relation(fields: [featurePageId], references: [id], onDelete: Cascade)
  issueId       String?
  issue         Issue?         @relation(fields: [issueId], references: [id], onDelete: SetNull)
  /// Title at the time of the event, so the feed still reads well after a delete.
  issueTitle    String
  type          IssueEventType
  field         String?
  fromValue     String?
  toValue       String?
  actor         String?
  createdAt     DateTime       @default(now())

  @@index([createdAt])
  @@index([featurePageId])
}

// ---------- QA Tracker ----------

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Resource {
  id        String    @id @default(cuid())
  name      String    @unique
  email     String?
  active    Boolean   @default(true)
  logs      TaskLog[]
  createdAt DateTime  @default(now())
}

model TaskLog {
  id          String     @id @default(cuid())
  resourceId  String
  resource    Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  description String
  status      TaskStatus @default(NOT_STARTED)
  hours       Float
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([resourceId, date])
  @@index([date])
}

// ---------- AI PR Review ----------

enum FlagType {
  LOGIC_ERROR
  REGRESSION_RISK
  SECURITY
  MISSING_ERROR_HANDLING
  REQUIREMENT_FIDELITY
}

enum FlagSource {
  CLAUDE_OUTPUT
  MANUAL
}

model Flag {
  id           String     @id @default(cuid())
  date         DateTime   @default(now())
  repo         String
  prNumber     Int?
  filePath     String?
  line         Int?
  flagType     FlagType
  detail       String
  severity     Severity
  suggestedFix String?
  loggedBy     String?
  source       FlagSource @default(MANUAL)
  createdAt    DateTime   @default(now())

  @@index([date])
  @@index([repo])
  @@index([flagType])
}

// ---------- TC Library ----------

model TestPlanEntry {
  id          String   @id @default(cuid())
  name        String
  prReference String?
  output      String
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

// ---------- PR QA Session ----------

model SessionTemplate {
  id         String   @id @default(cuid())
  name       String   @unique
  focusAreas String[]
  steps      Int[]
  context    String?
  specRef    String?
  createdAt  DateTime @default(now())
}

// ---------- CI Reports ----------

/// A user-added CI suite. Nothing is hard-coded; the page is built from these rows.
model CiSuite {
  id             String   @id @default(cuid())
  name           String
  /// GitHub repo as "owner/name".
  repo           String
  workflowFile   String
  color          String   @default("blue")
  /// [{ key, label, type: "text" | "choice", options?, default? }]
  dispatchInputs Json?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model RootCauseCache {
  runId     String   @id
  summary   String
  detail    String
  createdAt DateTime @default(now())
}

// ---------- App settings ----------

/// Simple global key/value settings (e.g. the ROI currency symbol).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Release Readiness ----------

enum ReleaseStatus {
  PLANNED
  IN_TESTING
  GO
  NO_GO
  GO_WITH_ISSUES
  RELEASED
}

enum GateType {
  MANUAL
  CI_GREEN
  NO_P0
  NO_P1
  VALID_RATE
  NO_P0_FLAGS
}

enum GateStatus {
  PENDING
  PASS
  FAIL
  NA
}

enum SignoffDecision {
  PENDING
  APPROVE
  REJECT
}

enum ReleaseDecisionType {
  GO
  NO_GO
  GO_WITH_ISSUES
}

model Release {
  id                   String            @id @default(cuid())
  name                 String
  version              String?
  targetDate           DateTime?         @db.Date
  releasedAt           DateTime?         @db.Date
  owner                String?
  description          String?
  status               ReleaseStatus     @default(PLANNED)
  linkedCiSuiteIds     String[]
  linkedFeaturePageIds String[]
  linkedRepos          String[]
  gates                ReleaseGate[]
  signoffs             ReleaseSignoff[]
  decisions            ReleaseDecision[]
  events               ReleaseEvent[]
  riskPlans            RiskPlan[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([createdAt])
}

model ReleaseGate {
  id          String     @id @default(cuid())
  releaseId   String
  release     Release    @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  section     String
  title       String
  type        GateType   @default(MANUAL)
  /// Per-type settings, e.g. { maxAllowed } for NO_P1, { threshold } for VALID_RATE, { days } for NO_P0_FLAGS.
  config      Json?
  status      GateStatus @default(PENDING)
  isBlocker   Boolean    @default(false)
  weight      Int        @default(1)
  owner       String?
  evidenceUrl String?
  note        String?
  /// Auto gates: { status, note, by, at } when a person overrides the computed result.
  override    Json?
  /// Auto gates: { status, detail, checkedAt } from the last check.
  autoResult  Json?
  sortOrder   Int        @default(0)
  updatedBy   String?
  updatedAt   DateTime   @updatedAt

  @@index([releaseId, sortOrder])
}

model ReleaseSignoff {
  id        String          @id @default(cuid())
  releaseId String
  release   Release         @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  role      String
  name      String?
  decision  SignoffDecision @default(PENDING)
  comment   String?
  signedAt  DateTime?
  sortOrder Int             @default(0)

  @@index([releaseId])
}

model ReleaseDecision {
  id          String              @id @default(cuid())
  releaseId   String
  release     Release             @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  decision    ReleaseDecisionType
  comment     String
  knownIssues String[]
  /// Frozen copy of the checklist, score and sign-offs at decision time.
  snapshot    Json
  decidedBy   String?
  createdAt   DateTime            @default(now())

  @@index([releaseId, createdAt])
}

model ReleaseEvent {
  id        String   @id @default(cuid())
  releaseId String
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  type      String
  detail    Json
  actor     String?
  createdAt DateTime @default(now())

  @@index([releaseId, createdAt])
}

model ChecklistTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  /// [{ name, gates: [{ title, type, isBlocker, weight, config? }] }]
  sections  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Risk-Based Test Planner ----------

enum ChangeSize {
  NONE
  SMALL
  MEDIUM
  LARGE
  NEW_FEATURE
}

model RiskPlan {
  id             String     @id @default(cuid())
  name           String
  startDate      DateTime?  @db.Date
  endDate        DateTime?  @db.Date
  availableHours Float      @default(0)
  testers        Int?
  notes          String?
  releaseId      String?
  release        Release?   @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  /// Scoring weights; empty object = defaults.
  settings       Json       @default("{}")
  areas          RiskArea[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([createdAt])
}

model RiskArea {
  id             String     @id @default(cuid())
  planId         String
  plan           RiskPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  name           String
  /// Bug Tracker feature page (soft link; may point at a deleted page).
  featurePageId  String?
  changeSize     ChangeSize @default(MEDIUM)
  complexity     Int        @default(3)
  defectHistory  Int        @default(3)
  dependencies   Int        @default(3)
  businessImpact Int        @default(3)
  usageFrequency Int        @default(3)
  depthOverride  String?
  hoursOverride  Float?
  deferred       Boolean    @default(false)
  deferReason    String?
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([planId, sortOrder])
}

// ---------- Test Failure Analyzer ----------

model FailureAnalysis {
  id             String   @id @default(cuid())
  name           String
  source         String
  totalFailures  Int
  passed         Int?
  skipped        Int?
  categoryCounts Json
  clusters       Json
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model KnownIssue {
  id        String   @id @default(cuid())
  signature String   @unique
  label     String
  notes     String?
  createdAt DateTime @default(now())
}

model AiExplanationCache {
  signature   String   @id
  explanation Json
  createdAt   DateTime @default(now())
}

// ---------- API Test Playground ----------

model ApiCollection {
  id        String       @id @default(cuid())
  name      String
  sortOrder Int          @default(0)
  requests  ApiRequest[]
  createdAt DateTime     @default(now())
}

model ApiRequest {
  id           String        @id @default(cuid())
  collectionId String
  collection   ApiCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  name         String
  method       String
  url          String
  params       Json          @default("[]")
  headers      Json          @default("[]")
  auth         Json          @default("{}")
  body         Json          @default("{}")
  assertions   Json          @default("[]")
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([collectionId, sortOrder])
}

model ApiEnvironment {
  id        String   @id @default(cuid())
  name      String   @unique
  /// [{ key, value }]
  variables Json     @default("[]")
  createdAt DateTime @default(now())
}

// ---------- Automation ROI ----------

model AutomationProject {
  id                       String             @id @default(cuid())
  name                     String             @unique
  /// CI Reports suite (soft link; may point at a deleted suite).
  ciSuiteId                String?
  totalTests               Int
  automatedTests           Int
  manualMinutesPerTest     Float
  automatedSecondsPerTest  Float?
  runsPerMonth             Float?
  buildHours               Float
  maintenanceHoursPerMonth Float              @default(0)
  hourlyCost               Float?
  snapshots                CoverageSnapshot[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
}

model CoverageSnapshot {
  id             String            @id @default(cuid())
  projectId      String
  project        AutomationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date           DateTime          @db.Date
  totalTests     Int
  automatedTests Int
  createdAt      DateTime          @default(now())

  @@index([projectId, date])
}

// ---------- Test Data Generator ----------

/// Saved schema (field list + options). Built-in presets live in src/lib/testdata/presets.ts.
model DataSchema {
  id        String   @id @default(cuid())
  name      String   @unique
  fields    Json
  options   Json
  /// Shown in the preset chip row instead of "My schemas".
  isPreset  Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

// ---------- Test Case Generator ----------

enum TcGenMode {
  AI
  IMPORTED
  CHECKLIST
}

model TestCaseGeneration {
  id            String    @id @default(cuid())
  name          String
  requirement   String
  apiInput      String?
  context       Json
  options       Json
  selectedTypes String[]
  mode          TcGenMode
  summary       String?
  assumptions   String[]
  questions     String[]
  testCases     Json
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([updatedAt])
}
